{
  "name": "diplomaone-website",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible, self-hosted Firebase Authentication bundle for the static DiplomaOne website.",
  "scripts": {
    "build:auth": "node scripts/build-auth.mjs",
    "check:auth": "node scripts/build-auth.mjs --check",
    "test:auth": "node test_auth.js && node test_account.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/auth": "1.13.6"
  },
  "overrides": {
    "@firebase/app": "$@firebase/app"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  }
}
