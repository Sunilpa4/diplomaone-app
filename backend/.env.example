# Documentation only. Enter secrets DIRECTLY in the correct Netlify site's UI.
# Current live flow/readiness: backend/LIVE-LAUNCH.md. No live values go in Git.
# Values: Production context ONLY, never all contexts or preview branches.
# Scope: Functions only when offered. On Free, all scopes also exposes values
# to trusted production builds; do not upgrade. Never export/log env in builds.
# Never paste a key/JSON in chat, commit it, or place it in frontend assets.
# TEST payments only. Keep both checkout switches false during setup.
RAZORPAY_KEY_ID=rzp_test_ToAdJ9DdVMFeM2
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=diplomaone-53b4e
FIRESTORE_DATABASE_ID=(default)
# Dedicated server service account in the SAME project, Cloud Datastore User.
# These are server credentials, NOT the public Firebase web config/API key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Invite-only: at most 10 comma-separated Firebase test UIDs (not tokens/emails).
# Also required for the manual test-site /#/test-connection read-only check.
# Find your own Google user's UID privately in this project's Authentication Users.
# No Razorpay secret or product import is needed for that check; keep both flags off.
PAYMENTS_TESTER_UIDS=
PAYMENTS_TEST_ENABLED=false
PAYMENTS_PRIVATE_MIGRATION_CONFIRMED=false

# LIVE: explicitly isolated credentials; NEVER reuse test secrets/records.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_LIVE_PRIVATE_MIGRATION_CONFIRMED=false
PAYMENTS_LIVE_MERCHANT_CONFIRMED=false
PAYMENTS_LIVE_POLICIES_CONFIRMED=false
# Optional owner-only soft launch: up to 10 UIDs; empty allows all verified
# Google users ONLY after all four launch gates. Invalid lists fail closed.
PAYMENTS_LIVE_PILOT_UIDS=
# Owner terminal only, never a runtime launch switch. Still requires --mode=live.
# PAYMENTS_LIVE_IMPORT_CONFIRMED=false

# Private owner import only; runtime Functions get Blobs context from Netlify.
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
# No NETLIFY_DB_URL, paid Netlify Database or PostgreSQL migration is needed.
# Never set FIRESTORE_EMULATOR_HOST in Netlify; deployed code refuses it.
